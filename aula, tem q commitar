#include <stdio.h>
#include <stdlib.h>
# define pi 3.141592
#include <math.h>

int main (){
	
	float area, raio, areatrapezio, base, topo, altura;
	
		printf("insira o raio do circulo");
		scanf("%f", &raio);
		//area = M_PI* pow(raio,2);
		area = pi*(raio*raio);
		
		printf("a area do circulo de raio %f = %f", raio, area);
		
		printf("agora faremos a área do trapézio...\n");
		
		printf("fale a largura da base: \n");
		scanf("&f", &base);
	
		printf("fale a altura: \n");
		scanf("&f", &altura);
		
		printf("fale a largura do topo: \n");
		scanf("&f", &topo);
		
		((base + topo) * altura) /2 = areatrapezio;
		
		printf("%f", areatrapezio);
		
	
	return 0;
}
